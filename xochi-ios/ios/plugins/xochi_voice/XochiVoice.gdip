[config]
name="XochiVoice"
binary="XochiVoice.xcframework"
initialization="initialize_xochi_voice"
deinitialization="deinitialize_xochi_voice"
[dependencies]
linked=[]
embedded=[]
system=["Foundation.framework", "AVFoundation.framework", "Speech.framework", "UIKit.framework", "FoundationModels.framework"]
linker_flags=["-ObjC", "-lc++"]
[plist]
NSMicrophoneUsageDescription="Use your voice to guide Xochi, practice Spanish, or cheer. This app requests on-device recognition and does not save recordings. You can use touch instead."
NSSpeechRecognitionUsageDescription="Recognize spoken directions, Spanish practice, and encouragement on your device. This app does not send your recordings to a server. Touch controls are always available."
